ARG VARNISH_VERSION=9.1.0
FROM varnish:${VARNISH_VERSION}

USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libtool \
        automake \
        autoconf \
        autoconf-archive \
        python3-docutils \
        varnish-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY . .

# Recreate the VMOD interface after configure, as in the Alpine build.
RUN ./bootstrap \
    && rm -f src/vcc_querymodifier_if.c src/vcc_querymodifier_if.h \
    && make \
    && make install
